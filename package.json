{
  "name": "dsh-xiaozhushou",
  "version": "0.47.7",
  "description": "dsh小助手：秘书 / CEO / 史官 三角色助手的 DeepSeek Harness 插件，带本地待办台账、定点提醒、共享任务板与看板娘浮窗",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "flamencoff",
  "homepage": "https://github.com/Flamencoff/dsh-xiaozhushou#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flamencoff/dsh-xiaozhushou.git"
  },
  "bugs": {
    "url": "https://github.com/Flamencoff/dsh-xiaozhushou/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "assistant",
    "secretary",
    "todo",
    "reminder",
    "board",
    "pet"
  ],
  "engines": {
    "node": ">=20",
    "dsh": "0.2.1-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./roles": "./roles/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "core/",
    "roles/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node test/harness.mjs",
    "check": "node scripts/check-release.mjs",
    "market:index": "node scripts/build-market-index.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  }
}
